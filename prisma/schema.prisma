generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  createdAt    DateTime     @default(now())
  sessions     Session[]
  diagnostics  Diagnostic[]
}

// Login sessions. The cookie holds a random token; only its SHA-256 hash is stored.
model Session {
  id        String   @id // sha256(token)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// One diagnostic conversation in one domain, and the report it produced.
model Diagnostic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain    String // "money" | "relationships" | "fitness" | "happiness"
  // "in_progress": still talking; "ready": AI emitted the readiness marker;
  // "generating": the report is being built in the background;
  // "completed": report generated and saved.
  status    String   @default("in_progress")
  // Full message history exactly as sent to the model, starting with the
  // "Begin the diagnostic." user turn. JSON array of {role, content}.
  messages  Json     @default("[]")
  userTurns Int      @default(0)

  reportRaw     String? // unparsed model output, kept for safety
  reportDraft   String? // first draft before the review pass
  reportChecks  Json? // denial check: audit and what each round flagged and deleted
  reportStartedAt DateTime? // when background report generation started
  reportError   String? // last report failure, shown to the person
  narrative     String?
  constraint    String?
  counterBelief String?
  completedAt   DateTime?

  // Architect diagnosis (version 2): 8 fixed questions, 2 taps, a reaction
  // after each, then a 12 card report. Version 1 rows are the retired open
  // chat and its report, still shown with the old renderer.
  version    Int      @default(1)
  flow       Json? // {answers, taps, reactions, halfwaySeen}, saved after every step
  crisis     Boolean  @default(false) // a reaction came back with the crisis flag
  reportJson Json? // the checked report: {hidden_tie, sections, old_bullets, new_bullets}

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}
