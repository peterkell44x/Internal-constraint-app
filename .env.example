# SQLite file used for local development (created by `npm run db:migrate`).
DATABASE_URL="file:./dev.db"

# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=""

# Optional. Defaults to the model the prototype was tuned on (claude-sonnet-4-6).
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Passcode required to create an account. Locally, leaving it empty keeps
# sign-up open; in production, an empty value closes sign-up entirely.
# SIGNUP_PASSCODE=""

# Optional. Comma-separated account emails that see "How this report was
# checked" (draft, audit, check rounds) under each report. Unset = nobody.
# REPORT_DEBUG_EMAILS=""
